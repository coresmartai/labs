# Copy to .env: `cp .env.example .env`. Everything here is real - a real
# embedding model, a real chat model, a real Qdrant service, real Presidio.
# You need an OpenAI key and either local Docker or a free Qdrant Cloud
# cluster (see the QDRANT_URL note below). spaCy is required: Presidio needs it.
#
#   pip install -r requirements.txt
#   python -m spacy download en_core_web_lg
#   docker run -d -p 6333:6333 qdrant/qdrant   # or set QDRANT_URL to a Cloud cluster instead
#   python -m app.ingest --reset
#   uvicorn app.main:app --reload

# ---- models ----
# Required. No default - a missing key fails the boot, not the first request.
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# 3072-dim. Changing this changes the vector width, so re-index afterwards:
# python -m app.ingest --reset
OPENAI_EMBED_MODEL=text-embedding-3-large
REQUEST_TIMEOUT_SECONDS=60

# ---- retrieval ----
RETRIEVAL_TOP_K=5
# Minimum cosine score for a chunk to be returned at all. Calibrated for
# text-embedding-3-large. This is what keeps the ACL behaviour honest.
SIMILARITY_THRESHOLD=0.55

# ---- Presidio ----
SPACY_MODEL=en_core_web_lg
PRESIDIO_REDACT_THRESHOLD=0.65
PRESIDIO_LOG_ONLY_THRESHOLD=0.35
# replace -> <REDACTED> in place of the span. Presidio's own default is also
# `replace`, but with <ENTITY_TYPE>; we substitute a single token instead.
PRESIDIO_OPERATOR=replace
OUTPUT_SCRUBBER_MAX_BUFFER=280

# ---- vector store: Qdrant ----
# Local Docker (default): docker run -d -p 6333:6333 qdrant/qdrant
# Qdrant Cloud alternative: create a free cluster at https://cloud.qdrant.io,
# then set QDRANT_URL to the cluster URL and QDRANT_API_KEY to its API key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=citation_rag

# ---- audit log ----
AUDIT_LOG_PATH=./audit.jsonl
# Salt for the user-id hash. Generate your own: `openssl rand -hex 16`.
# In production this lives in a secrets vault, NEVER co-located with the log.
USER_ID_HASH_SALT=change-me-32-hex-chars

# ---- defence toggles (see README "Common failure modes") ----
# All true in the shipped configuration. Turn one off to watch the attack it
# stops land, then turn it back on.
STARTUP_CHECK_ENABLED=true
INJECTION_CLASSIFIER_ENABLED=true
RETRIEVAL_SANITISER_ENABLED=true
CHUNK_SCRUB_ENABLED=true

LOG_LEVEL=INFO
