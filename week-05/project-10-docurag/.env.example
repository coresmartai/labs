# OpenAI API
OPENAI_API_KEY=your-key-goes-here

# Pinned model versions (no "latest")
LLM_MODEL=gpt-5.4-mini-2026-03-17
EMBED_MODEL=text-embedding-3-large

# --- Qdrant (the same store Week 4 KnowledgeVault wrote) ---
# local  = embedded in this process, reading QDRANT_LOCAL_PATH. No Docker,
#          no signup. Default. Point QDRANT_LOCAL_PATH at the qdrant_local/
#          folder inside your Week 4 knowledgevault project, or copy that
#          folder here. One process at a time: stop the Week 4 server before
#          starting CitationRAG.
# server = a running Qdrant at QDRANT_URL (Docker, or Qdrant Cloud + API key).
QDRANT_MODE=local
QDRANT_LOCAL_PATH=../../week-04/knowledgevault/qdrant_local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledgevault

# Retrieval thresholds (calibrated for text-embedding-3-large cosine scores
# against the Week 4 lab index - the single Attention paper)
# The gate checks the dense cosine score, not the RRF score.
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.55
SPREAD_DELTA=0.08

# Paths
GOLDEN_DATASET_PATH=./data/golden_dataset.json

# Logging
LOG_LEVEL=INFO
