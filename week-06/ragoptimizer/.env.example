# Copy to .env and fill in. Never commit .env.

# --- OpenAI ---
OPENAI_API_KEY=your-openai-key
MODEL_ID=gpt-5.4-mini-2026-03-17
HYDE_MODEL=gpt-5.4-nano-2026-03-17

# --- Qdrant (copy from Week 4 .env) ---
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=knowledgevault

# --- Retrieval (must match Week 4 index - 3072-dim vectors) ---
OPENAI_EMBED_MODEL=text-embedding-3-large
VECTOR_TOP_K_WIDE=30
VECTOR_TOP_K_NARROW=5

# --- HyDE ---
HYDE_ENABLED=true
HYDE_PROMPT_VOICE=academic_researcher

# --- Reranker ---
# Set to false in Part C of the guided lab, to measure what the reranker contributes.
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_BATCH_SIZE=30
RERANKER_CPU_THREADS=4

# --- Compressor ---
COMPRESSOR_ENABLED=true
COMPRESSOR_KEEP_FRACTION=0.80

# --- SLA / Benchmarking ---
P95_LATENCY_BUDGET_MS=2000
GOLDEN_DATASET_PATH=./data/golden_dataset.json
BOOTSTRAP_RESAMPLES=10000
