# Copy to .env and fill in. Only the first line is required.
OPENAI_API_KEY=your-openai-api-key

# Optional. Pinned defaults live in app/config.py; these are here to be read.
# One pin per agent, so re-pointing one cannot silently re-point another.
TRIAGE_MODEL=gpt-5.4-nano-2026-03-17
ACCESS_MODEL=gpt-5.4-mini-2026-03-17
SOFTWARE_MODEL=gpt-5.4-mini-2026-03-17
HARDWARE_MODEL=gpt-5.4-nano-2026-03-17

# Super-steps per run, not node executions. LangGraph's default is 1000 from
# v1.0.6, which on a graph this small is no guardrail at all.
RECURSION_LIMIT=10

# How many chunks each scope returns. Small on purpose: a broken scope filter is
# invisible at k=20 and obvious at k=3.
RETRIEVAL_K=3

LOG_LEVEL=INFO
