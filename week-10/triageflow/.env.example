# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Models (pinned, do not use *-latest in production code)
TRIAGE_MODEL=gpt-5.4-nano-2026-03-17
KNOWLEDGE_MODEL=gpt-5.4-mini-2026-03-17
# Its own pin. The action agent is a different cost profile from the knowledge
# agent, and one setting for both means you cannot move either alone.
ACTION_MODEL=gpt-5.4-mini-2026-03-17

# Graph safety cap, counted in SUPER-STEPS and not in node executions.
# LangGraph's default is 1000 from v1.0.6 onward, so on a graph this size the
# default is no guardrail at all. Set it low, explicitly.
RECURSION_LIMIT=10

# How long an approval stays good. The world moves while a human decides, and a
# proposal approved an hour ago may be wrong now. Past this, the node re-proposes
# instead of executing a stale plan.
APPROVAL_TTL_SECONDS=900

# Who may approve a gated action. Role, not ownership.
APPROVER_IDS=ops_lead

# Browsers allowed to call this API. Never "*" on a server that exposes
# DELETE /user/{uid} and POST /approve.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Vector-store backend for external + episodic memory.
#   memory   = in-process cosine index (default). No server, no network, no Docker.
#   pgvector = real PostgreSQL 16 + the `vector` extension, from an embedded
#              pip-installed binary. Still no Docker.
#              First: pip install -r requirements-pgvector.txt
MEMORY_BACKEND=memory
PGVECTOR_DATA_DIR=.pgdata

# Postgres (checkpointer in production - see langgraph.checkpoint.postgres)
POSTGRES_DSN=postgresql://triage:triage@localhost:5432/triageflow

# Redis (session memory)
REDIS_URL=redis://localhost:6379/0

# LangSmith tracing (optional) - uncomment LANGSMITH_TRACING and set the API key
# to see every node, prompt, and token count as a waterfall trace in LangSmith.
# LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=triageflow

# App
APP_ENV=dev
LOG_LEVEL=INFO
