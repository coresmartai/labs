# BreakRAG™ - environment variables
# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real keys.

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Required for answer generation (SUT) and both judge models.
# Paste the key from platform.openai.com after the = sign. Leave it empty and
# the judges report themselves unavailable instead of failing with a 401.
OPENAI_API_KEY=

# SUT model - generates answers from retrieved context (mirrors W5 CitationRAG).
SUT_MODEL=gpt-5.4-mini-2026-03-17

# Judge models - score each SUT answer independently on a 0-5 rubric.
# PRIMARY judge = nano tier (OPENAI_MODEL_NANO); SECONDARY = mini (OPENAI_MODEL).
# Caveat: the secondary judge shares the SUT's model - the Δ>1 disagreement flag
# and the independent nano primary cover the self-grading bias risk.
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_MODEL_NANO=gpt-5.4-nano-2026-03-17

# ── Qdrant: the same store Week 4 wrote and Week 5 read ──────────────────────
# local  (default) = the embedded store folder. One process at a time: stop
#                    the Week 4, 5 or 6 server before starting this one.
# server           = a running Qdrant (Docker or Cloud) at QDRANT_URL.
# snapshot         = no live store (Project 14, when the service under test
#                    holds the embedded folder). Run scripts/snapshot_corpus.py
#                    first; the leakage checks read CORPUS_SNAPSHOT_PATH.
QDRANT_MODE=local
CORPUS_SNAPSHOT_PATH=runs/corpus_snapshot.json
QDRANT_LOCAL_PATH=../../week-04/knowledgevault/qdrant_local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledgevault

# Embedding model - must match what was used to index the collection.
EMBED_MODEL=text-embedding-3-large

# Retrieval thresholds (calibrated for text-embedding-3-large cosine scores).
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.55
SPREAD_DELTA=0.08

# ── System under test (SUT) ───────────────────────────────────────────────────
# Self-contained mode (Project 13): BreakRAG evaluates its own /answer route,
# so the harness and the service are one process on port 8000.
#
# External mode (Project 14): your own service stays on its usual port 8000
# and the harness starts on another one:
#   uvicorn app.main:app --port 8001
# SUT_BASE_URL still names the service, so it does not change.
SUT_BASE_URL=http://localhost:8000
SUT_TIMEOUT_SECONDS=30

# ── Eval harness thresholds ───────────────────────────────────────────────────
ADVERSARIAL_PASS_RATE_FLOOR=0.70
JUDGE_AGREEMENT_ALPHA_FLOOR=0.60
MIN_SAMPLES=50
BOOTSTRAP_RESAMPLES=5000
# Reported, never gated: a case whose two judges differ by more than this.
JUDGE_DISAGREEMENT_DELTA=1.0
# Embedding leakage check: flag a seed above this percentile of the corpus's
# own nearest-neighbour similarity; cap the passages used for that baseline.
EMBEDDING_LEAKAGE_PERCENTILE=99
LEAKAGE_CORPUS_CAP=600

# ── Adversarial generator ─────────────────────────────────────────────────────
# Cases/seed = total adversarial cases per seed question (min 6).
# 7 = 1 SEED + 2 TYPO + 1 JAILBREAK + 1 MULTI_HOP + 1 CONFLICT + 1 HOSTILE
RED_TEAM_CASES_PER_SEED=7
SEED_SET_PATH=app/seeds/golden_set.json

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
