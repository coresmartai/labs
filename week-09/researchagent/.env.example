# Copy to .env and fill in. Missing required values fail at import time.

# Required.
OPENAI_API_KEY=your-openai-api-key

# Optional - pinned defaults are in config.py.
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
MAX_ITERS=10
MAX_WALL_CLOCK_SECONDS=120
REQUEST_TIMEOUT_SECONDS=60
MAX_COMPLETION_TOKENS=4096
LOG_LEVEL=INFO

# The dollar-cost stop. Unset = off (the default). Set a float to arm it:
# the loop stops with stop_reason "cost_budget" when the run's accumulated
# cost reaches the ceiling.
# MAX_COST_USD=0.05
#
# Prices are looked up from config.MODEL_PRICES using OPENAI_MODEL, so you
# normally leave these alone. Dollars per MILLION tokens:
#   gpt-5.4-nano-2026-03-17   0.20 in / 1.25 out
#   gpt-5.4-mini-2026-03-17   0.75 in / 4.50 out   <- the pinned model
#   gpt-5.4-2026-03-05        2.50 in / 15.00 out
# The snapshot dates are not uniform. mini and nano are dated 2026-03-17;
# the base model is dated 2026-03-05. Pin the one you mean, exactly.
# Cached input is exactly 10% of input (mini: 0.075).
# Override only if the list price moves:
# PRICE_PER_1M_INPUT_USD=0.75
# PRICE_PER_1M_OUTPUT_USD=4.50
# PRICE_PER_1M_CACHED_INPUT_USD=0.075

# YOUR STOP CONDITION's settings go here, and in app/config.py.
# Nothing above answers "is this research finished?".
