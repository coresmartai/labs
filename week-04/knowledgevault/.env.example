# --- OpenAI (vision describer + text embeddings) ---
OPENAI_API_KEY=your-key-goes-here
# Primary vision model: quality + speed balance
OPENAI_VISION_MODEL=gpt-5.4-mini-2026-03-17
# Fast vision model: low-confidence re-describe passes
OPENAI_VISION_FAST_MODEL=gpt-5.4-nano-2026-03-17
OPENAI_EMBED_MODEL=text-embedding-3-large

# --- Qdrant (vector store) ---
# local  = embedded in this process, stored under QDRANT_LOCAL_PATH. No Docker,
#          no signup. Default. One process at a time: stop the server before a
#          CLI ingest, or ingest through POST /ingest while it runs.
# server = a running Qdrant at QDRANT_URL (Docker, or Qdrant Cloud + API key).
QDRANT_MODE=local
QDRANT_LOCAL_PATH=./qdrant_local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledgevault

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DATA_DIR=./data/sample
