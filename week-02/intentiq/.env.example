# Copy this file to .env and fill in your keys.
# Update keys before pushing anywhere.

# --- OpenAI (shared key - covers both openai and nano providers) ---
OPENAI_API_KEY=sk-...

# --- Model pins (do not use *-latest; pin the version explicitly) ---
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
NANO_MODEL=gpt-5.4-nano-2026-03-17

# --- Ollama (local inference - zero API cost) ---
# Start Ollama: ollama serve
# Pull the model: ollama pull qwen3:0.6b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:0.6b

# --- App ---
LOG_LEVEL=INFO
