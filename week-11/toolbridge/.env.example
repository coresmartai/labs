# ToolBridge configuration. Copy to .env and edit.
#
# NOTE ON THE SDK: this project pins mcp 2.2.0, which speaks the 2026-07-28
# revision: stateless, no initialize handshake, MCPServer instead of FastMCP.
# The two guided builds this week pin mcp 1.28.1, which speaks 2025-11-25.
# They are different majors. Use a SEPARATE virtual environment for this project.

# --- the peer we bridge to ---------------------------------------------------
# A running AgentMesh. In solo mode this is a second copy on port 8001.
PEER_BASE_URL=http://localhost:8001

# The bearer ToolBridge presents to the peer. With the peer in AUTH_MODE=dev
# this is its DEV_BEARER_TOKEN (the shipped default is demo-token).
PEER_TOKEN=demo-token

# --- this server -------------------------------------------------------------
# stdio for a local host; http when something on another machine must reach it.
MCP_SERVER_TRANSPORT=stdio
MCP_SERVER_PORT=8770

# "good" or "bad". Swaps the tool description set so you can measure the
# difference in tool-pick accuracy rather than being told about it.
TOOL_DESCRIPTION_QUALITY=good

# How the human gate is crossed. See TASK 4 and the design memo.
#   resume    - return a structured pending result; the model calls resume_task
#   elicit    - ask the MCP client, via the SDK's elicitation round trip
HUMAN_GATE_MODE=resume

# How long to follow a peer's stream before giving up, in seconds.
FOLLOW_TIMEOUT_SECONDS=90

# Only needed to run the tool-pick eval. Tests never dial it.
OPENAI_API_KEY=your-key-here
PICKER_MODEL=gpt-5.4-nano-2026-03-17
