# Provider key
OPENAI_API_KEY=your-key-here

# Optional: point the OpenAI SDK at any OpenAI-compatible endpoint.
# Leave unset for the provider default. Set it to a gateway, a proxy, or a
# self-hosted open-weight checkpoint (vLLM, Ollama, LM Studio) and the code
# does not change - only OPENAI_MODEL below has to name whatever that
# endpoint calls the model.
# OPENAI_BASE_URL=http://localhost:11434/v1

# Model pin - dated string, NEVER `-latest`
OPENAI_MODEL=gpt-5.4-nano-2026-03-17

# App
LOG_LEVEL=INFO

# Tool description quality - flip it and restart to reproduce the eval failure mode
TOOL_DESCRIPTION_QUALITY=good  # or "bad"

# MCP server transport (python -m app.mcp_server)
MCP_SERVER_TRANSPORT=stdio  # or "http"
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8766
