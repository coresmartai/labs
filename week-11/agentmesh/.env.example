# Provider key - REQUIRED. A missing value is a startup error naming the field.
OPENAI_API_KEY=your-key-here

# Optional: point the OpenAI SDK at any OpenAI-compatible endpoint (gateway, proxy,
# or a self-hosted open-weight checkpoint). Leave unset for the provider default.
# OPENAI_BASE_URL=http://localhost:11434/v1

# Dual model pin - dated strings, NEVER `-latest`.
# Displayed on /health. Nothing in this repo dials them at runtime: the triage core
# is deterministic. app/llm.py is the seam they are wired through.
TRIAGE_MODEL=gpt-5.4-nano-2026-03-17
KNOWLEDGE_MODEL=gpt-5.4-mini-2026-03-17

# Student identity - CHANGE THESE BEFORE A COHORT SESSION.
# They land in your Agent Card, the whoami MCP tool and the whoami A2A skill -
# they are how classmates know whose agent they reached.
STUDENT_ID=stu_000
STUDENT_NAME=Unnamed Student
STUDENT_SPECIALTY=incident-triage

# A2A service.
# AGENTMESH_BASE_URL is stamped into your Agent Card AND into the stream_url of
# every 202 ack. Behind a tunnel it MUST be your public URL, or classmates submit
# tasks that run fine here and stream nowhere. See SESSION.md.
AGENTMESH_HOST=0.0.0.0
AGENTMESH_PORT=8000
AGENTMESH_BASE_URL=http://localhost:8000
A2A_PROTOCOL_VERSION=1.0

# Solo or online. This is the master switch for the whole cohort experience:
#   solo   - localhost only, with the local dummy peers cohort.json lists. No tunnel,
#            no classmates, nothing to set up. The default, and where you start.
#   online - your cloudflared URL plus the class's live roster. Requires a tunnel and
#            cohort.json's online.my_base_url set to it.
# It lives here, not in cohort.json, because which mode YOU run is a per-machine
# choice while cohort.json is shared. The scripts and the notebook read it from here.
COHORT_MODE=solo

# Optional: the cohort's published card index, so cohort_lookup can resolve
# classmates from the live roster instead of the built-in fixtures.
# COHORT_REGISTRY_URL=https://<project>-default-rtdb.firebaseio.com/public/agents.json

# Bearer used when YOU call a classmate. Normally leave this unset: a Firebase ID
# token expires after an hour, so a value pasted here goes stale mid-session and the
# resulting 401s look like a code bug. scripts/a2a_client.py already prefers a freshly
# refreshed token from the cohort site (scripts/boss.py) when you are signed in.
# Set it only for a fixed token, e.g. AUTH_MODE=dev sessions.
# A2A_PEER_TOKEN=demo-token

# Auth mode.
#   dev  - accepts the fixed DEV_BEARER_TOKEN below. This is SOLO MODE: no accounts,
#          no network, the browser demo and both clients work out of the box.
#   jwks - verifies real JWTs against JWT_JWKS_URL. This is what a LIVE CLASS runs on,
#          because a shared password cannot tell one classmate from another.
# DEV_SCOPES is a FIXED grant - dev mode does not hand out whatever scope a route asks
# for, so a 403 is still reachable without a real IdP.
AUTH_MODE=dev
DEV_BEARER_TOKEN=demo-token
DEV_SCOPES=["triage:invoke","mcp:invoke"]

# JWT verification - used when AUTH_MODE=jwks.
#
# The cohort's identity provider is Firebase Auth: it issues each student a signed ID
# token when they sign in, and Google publishes the public keys your agent verifies
# against. Nothing here is a secret, and there is no key for you to hold - which is the
# point of JWKS. You never see a classmate's password, only their signed token.
#
# ISSUER and AUDIENCE both carry the cohort's Firebase project id. The JWKS URL is the
# same for every Firebase project on earth, so the project id is the only thing that
# changes between cohorts. Claiming a callsign on the cohort site prints this exact
# block for you - paste it rather than typing it.
JWT_ISSUER=https://securetoken.google.com/coresmart-agentmesh
JWT_AUDIENCE=coresmart-agentmesh
JWT_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
JWT_JWKS_CACHE_SECONDS=86400
# Covers small clock differences between laptops. It does NOT meaningfully extend an
# expired token: Firebase IDs last an hour, so a long session needs a fresh one.
JWT_LEEWAY_SECONDS=30

# MCP cohort server.
# Standalone process (`python -m app.mcp_server`): stdio for local hosts like
# Claude Desktop, or its own HTTP port. No auth on THAT path - it is local only.
MCP_SERVER_TRANSPORT=stdio  # or "http"
MCP_SERVER_PORT=8766

# Which description table app/tools.py hands FastMCP.
# Set it to "bad" and reconnect a host to watch tool-pick accuracy fall over.
TOOL_DESCRIPTION_QUALITY=good  # or "bad"

# Co-hosting: also serve MCP from the A2A app, same port, at MCP_MOUNT_PATH - so
# ONE tunnel exposes both protocols. This surface IS bearer-gated (it is public),
# using the same auth as A2A but its own scope.
COHOST_MCP=true
MCP_MOUNT_PATH=/mcp
MCP_REQUIRED_SCOPE=mcp:invoke

# Task store - "memory" (default, bounded replay buffer) or "sqlite" (durable,
# unbounded replay). Same four-method interface either way.
TASK_STORE_BACKEND=memory
TASK_STORE_SQLITE_PATH=./data/tasks.db
TASK_REPLAY_BUFFER_SIZE=100

# Logging. Console always; a rotating file too (LOG_TO_FILE) so a session auto-saves to
# disk - every request, including who reached your agent over the tunnel. logs/ is gitignored.
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE=logs/agentmesh.log
# LOG_MAX_BYTES=1000000   # roll over at ~1 MB
# LOG_BACKUP_COUNT=5      # keep this many rolled files
