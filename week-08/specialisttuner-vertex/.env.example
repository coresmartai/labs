# ─── GCP project + region ─────────────────────────────────────────────────
# Vertex AI Gemini supervised tuning is regional. Pick a region that supports
# the source model. gemini-3.1-flash-lite is available in us-central1.
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1

# ─── Model pin ───────────────────────────────────────────────────────────
# The dated identifier makes fine-tunes reproducible against a fixed base.
#
# CHECK THIS BEFORE YOU SPEND ANYTHING. Which models a service will *tune* is a
# shorter list than which models it will *serve*, it is a product decision, and
# it changes with every model generation. The supported-model list is at
#   https://cloud.google.com/vertex-ai/generative-ai/docs/models/tuning-models
# If the model below is not on that list on the day you run this, take the
# nearest successor from the list and change it here. Nothing else in the
# package hard-codes a model name.
SOURCE_MODEL=gemini-3.1-flash-lite-001

# ─── GCS bucket for training data + tuning artefacts ─────────────────────
# The bucket must be in the same region as GCP_LOCATION.
GCS_BUCKET=gs://your-tuning-bucket
GCS_TRAIN_PREFIX=aiayn/train
GCS_EVAL_PREFIX=aiayn/eval

# ─── Local paths ─────────────────────────────────────────────────────────
GENERIC_DATASET_PATH=./data/aiayn_generic.jsonl
GCLOUD_DATASET_PATH=./data/aiayn_gcloud.jsonl
EVAL_DATASET_PATH=./data/eval_aiayn.jsonl

# ─── Tuning hyperparameters (all overridable via env) ────────────────────
TUNING_EPOCHS=4
TUNING_ADAPTER_SIZE=4
LEARNING_RATE_MULTIPLIER=1.0
TUNED_MODEL_DISPLAY_NAME=specialisttuner-aiayn

# ─── Serving ─────────────────────────────────────────────────────────────
MODEL_HOST=0.0.0.0
MODEL_PORT=8000
LOG_LEVEL=INFO
