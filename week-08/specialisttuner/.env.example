# Hugging Face token with READ access to Qwen (if private) + WRITE to your namespace
HF_TOKEN=your-token

# Where the LoRA adapter gets pushed
HF_HUB_REPO=your-org/specialisttuner-qwen3-lora

# Local base model name (use the exact model ID from HuggingFace)
BASE_MODEL=Qwen/Qwen3-0.6B

# Training dataset path (JSONL on disk, one example per line)
DATASET_PATH=./data/specialisttuner.jsonl

# Output directory for checkpoints + adapter
OUTPUT_DIR=./out

# Optional: WandB / TensorBoard logging dir
LOG_DIR=./logs

# Model serving (FastAPI)
MODEL_HOST=0.0.0.0
MODEL_PORT=8000
