# ReleaseBot - environment variables
# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# --- OpenAI (required) ---
OPENAI_API_KEY=your-openai-key-here
# Optional overrides (defaults shown):
# OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# OPENAI_FALLBACK_MODEL=gpt-5.4-nano-2026-03-17

# --- Gmail SMTP, for the send_email tool (required) ---
# SMTP_SENDER is your Gmail address.
# SMTP_PASSWORD is a 16-character Gmail App Password
# (Google account -> 2-Step Verification -> App passwords).
SMTP_SENDER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# --- App (optional; defaults shown) ---
# APP_HOST=0.0.0.0
# APP_PORT=8000
# LOG_LEVEL=INFO
